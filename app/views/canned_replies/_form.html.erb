<%= form_with model: canned_reply do |f| %>
  <% if canned_reply.errors.any? %>
    <p class="flash alert"><%= canned_reply.errors.full_messages.to_sentence %></p>
  <% end %>
  <%= f.label :title %>
  <%= f.text_field :title %>
  <%= f.label :body %>
  <%= f.text_area :body, rows: 8 %>
  <p class="meta">You can use <%= safe_join(CannedReply::PLACEHOLDERS.map { |name| tag.code("{{#{name}}}") }, ", ") %>.</p>
  <%= f.submit "Save" %>
<% end %>
