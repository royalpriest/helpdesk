<% content_for :title, "Tickets" %>

<%= turbo_stream_from :tickets %>

<h1>Tickets</h1>

<%= form_with url: tickets_path, method: :get, class: "search" do |f| %>
  <%= f.hidden_field :filter, value: @filter %>
  <% if @inboxes.size > 1 %>
    <%= f.select :inbox, @inboxes.map { |inbox| [ inbox.name, inbox.id ] }, { include_blank: "All inboxes", selected: @inbox&.id }, aria: { label: "Inbox" } %>
  <% end %>
  <%= f.search_field :q, value: @query, placeholder: "Search subjects, messages and customers", aria: { label: "Search tickets" } %>
  <%= f.submit "Search", name: nil %>
<% end %>

<nav class="filters">
  <% TicketsController::FILTERS.each do |filter| %>
    <%= link_to tickets_path(filter: filter, q: @query.presence, inbox: @inbox&.id), class: ("active" if filter == @filter) do %>
      <%= filter.humanize %> <span class="count"><%= @counts[filter] %></span>
    <% end %>
  <% end %>
</nav>

<% if @tickets.any? %>
  <table class="tickets">
    <thead>
      <tr><th>#</th><th>Subject</th><th>Customer</th><th>Status</th><th>Assignee</th><th>Updated</th></tr>
    </thead>
    <tbody>
      <% @tickets.each do |ticket| %>
        <tr id="<%= dom_id(ticket) %>">
          <td><%= ticket.id %></td>
          <td>
            <%= link_to ticket.subject, ticket %>
            <% if @inboxes.size > 1 %><span class="inbox-name"><%= ticket.inbox.name %></span><% end %>
          </td>
          <td><%= ticket.customer.display_name %></td>
          <td><span class="status <%= ticket.status %>"><%= ticket.status %></span></td>
          <td><%= ticket.assignee&.display_name || "Unassigned" %></td>
          <td><%= time_ago_in_words(ticket.updated_at) %> ago</td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <% if @query.present? %>
    <p class="empty">No tickets match "<%= @query %>".</p>
  <% else %>
    <p class="empty"><%= t(".empty.#{@filter}") %></p>
  <% end %>
<% end %>
