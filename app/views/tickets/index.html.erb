<% content_for :workspace, "true" %>
<% content_for :title, "Tickets" %>

<%= turbo_stream_from :tickets %>

<div class="workspace">
  <%= render "list" %>

  <section class="detail-pane detail-empty" aria-label="Overview">
    <div class="overview">
      <h2>Pick a ticket to start</h2>
      <p class="muted">Tickets waiting longest are at the top. Press <kbd>⌘K</kbd> to search.</p>
      <div class="stats">
        <div class="stat">
          <span class="stat-value"><%= ticket_counts["unassigned"] %></span>
          <span class="stat-label">Unassigned</span>
        </div>
        <div class="stat">
          <span class="stat-value"><%= ticket_counts["mine"] %></span>
          <span class="stat-label">Assigned to you</span>
        </div>
        <div class="stat satisfaction">
          <span class="stat-value"><strong><%= @satisfaction ? "#{@satisfaction}%" : "–" %></strong></span>
          <span class="stat-label">Rated good, last 30 days</span>
        </div>
      </div>
    </div>
  </section>
</div>
