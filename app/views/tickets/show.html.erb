<% content_for :title, "#{@ticket.reference} #{@ticket.subject}" %>

<%= turbo_stream_from @ticket %>

<h1><%= @ticket.reference %> <%= @ticket.subject %></h1>
<p class="meta">From <%= @ticket.customer.display_name %> &lt;<%= @ticket.customer.email_address %>&gt;</p>

<% if @ticket.rated_at %>
  <p class="rating <%= @ticket.rating %>">
    Customer rated this <strong><%= @ticket.rating == "good" ? "👍 good" : "👎 not so good" %></strong>
    <%= time_ago_in_words(@ticket.rated_at) %> ago<% if @ticket.rating_comment.present? %>: “<%= @ticket.rating_comment %>”<% end %>
  </p>
<% end %>

<% if @other_tickets.any? %>
  <aside class="other-tickets">
    <h2>Other tickets from <%= @ticket.customer.display_name %></h2>
    <ul>
      <% @other_tickets.each do |other| %>
        <li id="<%= dom_id(other, :other) %>">
          <%= link_to "#{other.reference} #{other.subject}", other %>
          <span class="status <%= other.status %>"><%= other.status %></span>
        </li>
      <% end %>
    </ul>
  </aside>
<% end %>

<%= form_with model: @ticket, class: "ticket-controls" do |f| %>
  <%= f.label :assignee_id, "Assignee" %>
  <%= f.collection_select :assignee_id, @agents, :id, :display_name, include_blank: "Unassigned" %>
  <%= f.label :status %>
  <%= f.select :status, Ticket::STATUSES %>
  <%= f.submit "Update" %>
<% end %>

<% unless @ticket.assignee == Current.user %>
  <%= button_to "Assign to me", ticket_path(@ticket), method: :patch, params: { ticket: { assignee_id: Current.user.id } }, class: "secondary" %>
<% end %>

<section class="conversation">
  <%= render partial: "shared/message", collection: @ticket.messages.includes(:user, attachments_attachments: :blob), as: :message %>
</section>

<%= form_with model: [ @ticket, @message ], class: "reply", data: { controller: "canned-reply" } do |f| %>
  <% if @canned_replies.any? %>
    <label for="canned_reply">Insert canned reply</label>
    <select id="canned_reply" data-action="canned-reply#insert">
      <option value="">Choose…</option>
      <% @canned_replies.each do |reply| %>
        <option value="<%= reply.render_for(ticket: @ticket, agent: Current.user) %>"><%= reply.title %></option>
      <% end %>
    </select>
  <% end %>
  <%= f.label :body, "Reply" %>
  <%= f.text_area :body, rows: 8, data: { canned_reply_target: "body" } %>
  <div class="reply-actions">
    <%= f.submit "Send reply" %>
    <%= f.submit "Add internal note", name: "note", class: "secondary" %>
  </div>
<% end %>
